# 905029182dce485bbac4f8a14715f8cf
#: ../../discovery/part06/06_03-use_a_workbench.rst:26
msgid "기본 정보 영역"
msgstr ""

# e50288a0cae04605bcf0efa82c22db23
#: ../../discovery/part06/06_03-use_a_workbench.rst:28
msgid "현재 작업하는 워크벤치에 관한 정보가 나타나는 영역입니다."
msgstr ""

# d5771f1966154fe8b3ae23701ff8af01
#: ../../discovery/part06/06_03-use_a_workbench.rst:33
msgid "**이름:** 워크벤치의 이름입니다. 클릭하여 이름을 변경할 수 있습니다."
msgstr ""

# f6b4ddc84dc34e828023cecada073094
#: ../../discovery/part06/06_03-use_a_workbench.rst:34
msgid ""
"**데이터 커넥션:** 해당 워크벤치와 연결되어 있는 데이터 커넥션의 이름입니다. |icon_exclamation| 아이콘을 "
"클릭하면 자세한 정보가 나타납니다."
msgstr ""

# 7c67605a47f04c1db28abb320e08f31a
#: ../../discovery/part06/06_03-use_a_workbench.rst:35
msgid "|icon_folding| : 패널을 접고 펼치는 UI 버튼입니다"
msgstr ""

# 3833d01c57f04fe998164cb69b0c7ec0
#: ../../discovery/part06/06_03-use_a_workbench.rst:40
msgid "스키마 및 테이블 영역"
msgstr ""

# b94f0a88712b485784564e37efe18f93
#: ../../discovery/part06/06_03-use_a_workbench.rst:42
msgid "원하는 데이터베이스, 테이블, 컬럼을 손쉽게 쿼리 에디터에 입력할 수 있는 UI 기능입니다."
msgstr ""

# e37bdc56ff324559b8e8c0ede45abde6
#: ../../discovery/part06/06_03-use_a_workbench.rst:47
msgid ""
"**데이터베이스 이름:** 현재 선택된 데이터베이스의 이름을 출력해줍니다. 해당 워크벤치에 등록된 데이터 커넥션의 첫 번째 "
"데이터베이스를 기본적으로 선택됩니다. 클릭하면 데이터 커넥션에 포함된 모든 데이터베이스가 조회되며, 그 중에 하나를 선택하면 해당 "
"데이터베이스로 변경됩니다."
msgstr ""

# f8e6f59dc3f84d82a57ec95a54a7a802
#: ../../discovery/part06/06_03-use_a_workbench.rst:48
msgid ""
"**스키마 브라우저:** 선택된 데이터베이스의 테이블 목록과 각 테이블에 속한 모든 컬럼 및 레코드 정보를 확인할 수 있는 스키마 "
"브라우저 화면이 팝업됩니다."
msgstr ""

# 7bb9588c997e4b23890a057a09db9fb1
#: ../../discovery/part06/06_03-use_a_workbench.rst:49
msgid "**테이블 검색:** 선택된 데이터베이스에 등록된 테이블을 이름으로 검색합니다."
msgstr ""

# 03965517c2ca491bad27b08fa39769ba
#: ../../discovery/part06/06_03-use_a_workbench.rst:50
msgid ""
"**테이블 이름:** 필요한 데이터를 담은 테이블을 선택하면, 오른쪽 쿼리 에디터에 해당 테이블에 대한 ``SELECT \\* "
"FROM {table name}`` 쿼리가 자동으로 입력됩니다."
msgstr ""

# 00597e3067164d2ba7336990515bca09
#: ../../discovery/part06/06_03-use_a_workbench.rst:51
msgid ""
"**컬럼 목록:** 해당 테이블에 속한 모든 컬럼 이름과 각각의 데이터 타입이 나타납니다. 컬럼 이름을 클릭하면 쿼리 에디터에 "
"자동으로 삽입됩니다."
msgstr ""

# 3f582d8bb8c5464886a8c6665526933c
#: ../../discovery/part06/06_03-use_a_workbench.rst:56
msgid "쿼리 에디터 영역"
msgstr ""

# 701a6fc573e847eb998aa97565f86c2d
#: ../../discovery/part06/06_03-use_a_workbench.rst:58
msgid "쿼리를 작성하고 실행할 수 있는 에디터 화면입니다."
msgstr ""

# 9c469fb72c7c45288093d53ab56a138a
#: ../../discovery/part06/06_03-use_a_workbench.rst:63
msgid ""
"|icon_arrow| : 탭이 너무 많을 경우 탭 영역을 좌우로 스크롤 할수 있는 버튼입니다. 탭의 개수가 많지 않은 경우 "
"나타나지 않습니다."
msgstr ""

# 7dbdd7f63bae4482a3271752e954166f
#: ../../discovery/part06/06_03-use_a_workbench.rst:64
msgid ""
"**탭:** 쿼리 관리를 위해 여러 개의 탭으로 나누어서 쿼리를 실행하거나 저장할 수 있습니다. |icon_more| 버튼을 클릭 "
"시 탭 제목의 수정과 탭 삭제가 가능합니다."
msgstr ""

# 87fb12fb91914b2a856f05f525949873
#: ../../discovery/part06/06_03-use_a_workbench.rst:65
msgid "|icon_plus| : 이 버튼을 클릭하면 새로운 탭이 추가됩니다."
msgstr ""

# c26690469c0b4490b23ad2c4e320b92b
#: ../../discovery/part06/06_03-use_a_workbench.rst:66
msgid "|icon_full| : 이 버튼을 클릭하면 쿼리 에디터 영역을 전체화면으로 확장하거나 축소 할 수 있습니다."
msgstr ""

# 218a0fe5f8bf4751af58f762de4ce80e
#: ../../discovery/part06/06_03-use_a_workbench.rst:67
msgid "**쿼리 행:** 쿼리 코드의 행 번호를 보여줍니다."
msgstr ""

# ba61f9c092ec422680ef2813d7fc4250
#: ../../discovery/part06/06_03-use_a_workbench.rst:68
msgid ""
"**에디터 화면:** 이 곳에 쿼리 문을 작성합니다. 멀티 쿼리의 실행 및 단일 쿼리의 실행이 가능합니다. ``;``\\을 쿼리 "
"문이 끝날 때마다 삽입하면 쿼리를 나눠서 실행이 가능합니다. 자동완성 기능이 제공됩니다."
msgstr ""

# 20e57afecc804eb182b34608d991a93b
#: ../../discovery/part06/06_03-use_a_workbench.rst:69
msgid "**쿼리 전체 실행:** 쿼리 에디터에 작성된 전체 쿼리를 실행합니다. (단축키: Ctrl + Enter)"
msgstr ""

# 9cc736c97c48467495a1b9187f91e2b4
#: ../../discovery/part06/06_03-use_a_workbench.rst:70
msgid ""
"**쿼리 부분 실행:** 쿼리 문 안에서 마우스가 위치된 특정 쿼리 또는 드래그하여 선택된 영역만 쿼리를 실행합니다. (단축키: "
"Command + Enter)"
msgstr ""

# 017a85a8ddb14622b8af491cd6e23c61
#: ../../discovery/part06/06_03-use_a_workbench.rst:71
msgid "**CLEAR SQL:** 쿼리 문을 모두 삭제 합니다."
msgstr ""

# 3395a90b51d64ea0909f256b4aff8c8a
#: ../../discovery/part06/06_03-use_a_workbench.rst:72
msgid "**SQL BEAUTIFIER:** 이 버튼을 클릭하면 작성된 쿼리 문이 쿼리 문법 표준에 맞게 정렬됩니다."
msgstr ""

# 90d838318a71423084917f245ace9036
#: ../../discovery/part06/06_03-use_a_workbench.rst:73
msgid ""
"**Query History:** 쿼리 에디터에서 수행한 과거 목록을 조회할수 있으며, 쿼리 선택 시 쿼리문이 쿼리 에디터에 "
"추가됩니다."
msgstr ""

# 747600cec7514a8384241a2b48869506
#: ../../discovery/part06/06_03-use_a_workbench.rst:74
msgid "**Query Editor 단축키:** 쿼리 에디터에서 사용가능한 단축키 목록입니다."
msgstr ""

# 90b5bc519f8f4a2682cfef63bb87f75b
#: ../../discovery/part06/06_03-use_a_workbench.rst:79
msgid "쿼리 결과 영역"
msgstr ""

# 35ca0af726fc42449d24d5e666484a1e
#: ../../discovery/part06/06_03-use_a_workbench.rst:81
msgid ""
"쿼리가 실행되면 그 결과가 쿼리 결과 탭에 나타납니다. 모든 쿼리 결과는 계속 누적되지만, 원하는 결과 탭을 자유롭게 삭제할 수 "
"있습니다. 쿼리 결과는 텍스트 그리드 형태로 제공되며, 차트 미리보기, 데이터 소스 저장, 다운로드 CSV 기능이 지원됩니다."
msgstr ""

# cadd2a2bb1c84c1bb7da2095cb577f5e
#: ../../discovery/part06/06_03-use_a_workbench.rst:84
msgid "쿼리 수행 중"
msgstr ""

# 8d64c7b783134269a8e43e3766b57850
# 583c8307cbcf4e0080fbe55673cf74aa
#: ../../discovery/part06/06_03-use_a_workbench.rst:89
#: ../../discovery/part06/06_03-use_a_workbench.rst:118
msgid ""
"**쿼리 결과 탭:** 다중 쿼리 수행시 쿼리당 하나의 결과 탭이 생성되며 쿼리 수행 중인 탭일 경우 탭 제목에 'Loading' "
"메시지가 표시됩니다."
msgstr ""

# a35c607db1d14a97a04a87c58c78fff5
#: ../../discovery/part06/06_03-use_a_workbench.rst:90
msgid ""
"**쿼리 로그:** 쿼리 수행 로그를 보여주는 영역입니다. Hive 타입의 커넥션일 경우 Hive Job Log가 추가적으로 "
"표시됩니다."
msgstr ""

# d10305ca7e7146178e2606531721775f
#: ../../discovery/part06/06_03-use_a_workbench.rst:91
msgid "**쿼리 수행 취소:** 수행중인 쿼리를 취소합니다. DB 타입별 취소에 걸리는 시간이 다소 차이날 수 있습니다."
msgstr ""

# 9e26727eb6c44f78afd32ad1995ba836
#: ../../discovery/part06/06_03-use_a_workbench.rst:92
msgid "**쿼리 수행 단계:** 쿼리 수행의 총 5가지 단계 중 현재 단계를 표시합니다."
msgstr ""

