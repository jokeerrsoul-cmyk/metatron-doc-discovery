# 6844192741914d9cbe21bc6c1aee5cdf
#: ../../discovery/part02/data_monitoring.rst:2
msgid "데이터 모니터링"
msgstr ""

# 3134caffd8d34aaf9a436ec10994272f
#: ../../discovery/part02/data_monitoring.rst:4
msgid ""
"데이터 모니터링은 Metatron Workbench에서 유저가 Staging DB(내부 Hive DB) 및 Metatron과 연결된"
" 외부 데이터베이스에 질의하는 모든 로그를 관측하는 기능입니다."
msgstr ""

# e0cf1875987342d79dce1c635a0b427e
#: ../../discovery/part02/data_monitoring.rst:6
msgid ""
"데이터 모니터링 메뉴는 메인 화면 좌측 패널에서 **MANAGEMENT** > **데이터 스토리지** > **데이터 "
"모니터링**\\을 통해 진입할 수 있습니다."
msgstr ""

# 2198a6c58c714ea3bb0aecfceb74eca0
#: ../../discovery/part02/data_monitoring.rst:11
msgid "로그 통계"
msgstr ""

# a996c58ee3e04c0ea57d6f6f7decdc0b
#: ../../discovery/part02/data_monitoring.rst:13
msgid ""
"로그 통계에서는 Metatron Discovery 내 쿼리 수행과 관련된 각종 통계치를 모아서 보여줍니다. 여기에서는 아래와 같이 "
"총 9가지의 기본 통계를 조회할 수 있습니다."
msgstr ""

# 7f91e4e183d848638224d84d37e077b2
#: ../../discovery/part02/data_monitoring.rst:17
msgid "**쿼리 성공/실패율:** Metatron에서 실행된 쿼리들의 성공률과 실패율이 나타납니다."
msgstr ""

# 72a9d83b6ed547c9b5ae4ef4e87c1b2c
#: ../../discovery/part02/data_monitoring.rst:18
msgid ""
"**사용자 별 쿼리 빈도 수:** 쿼리를 수행한 사용자별 빈도수를 나타낸 그래프입니다. 표시된 막대 중 하나를 클릭하면 해당 "
"사용자가 실행한 Job Log를 볼 수 있습니다."
msgstr ""

# 5d7b80cea0a945bb9be7d5b8f34b1c3a
#: ../../discovery/part02/data_monitoring.rst:19
msgid "**오래 걸리는 순:** 수행한 쿼리들이 작업시간이 긴 순서대로 정렬되어 나타납니다."
msgstr ""

# 89ef0587266645afb135262e4fa53477
#: ../../discovery/part02/data_monitoring.rst:20
msgid "**스캔 데이터량:** 수행한 쿼리들이 데이터를 제일 많이 스캔한 순서대로 정렬되어 나타납니다."
msgstr ""

# 1206dd9a0e584a888b99d64f9e98d816
#: ../../discovery/part02/data_monitoring.rst:21
msgid "**성공한 쿼리 빈도:** 수행한 쿼리들이 성공한 빈도가 높은 순서대로 정렬되어 나타납니다."
msgstr ""

# 0649ff8af2904639bb95332ff456ff1c
#: ../../discovery/part02/data_monitoring.rst:22
msgid "**실패한 쿼리 빈도:** 수행한 쿼리들이 실패한 빈도가 높은 순서대로 정렬되어 나타납니다."
msgstr ""

# 5c3054376b5341408ba443de33b06f99
#: ../../discovery/part02/data_monitoring.rst:23
msgid "**총 메모리 사용량:** 수행한 쿼리들이 총 메모리 사용량이 큰 순서대로 정렬되어 나타납니다."
msgstr ""

# bd4f35f3aa3d4f6b954639f3823133e0
#: ../../discovery/part02/data_monitoring.rst:24
msgid "**총 CPU 사용량:** 수행한 쿼리들이 총 CPU 사용량이 큰 순서대로 정렬되어 나타납니다."
msgstr ""

# b8940dfe01a64e18b6ba02feb014597f
#: ../../discovery/part02/data_monitoring.rst:25
msgid "**Queue별 리소스 사용량:** Hadoop 환경의 각 YARN queue에서 소모되는 리소스량을 보여줍니다."
msgstr ""

# e9a6fd143e99472dbd46c9fc03d30743
#: ../../discovery/part02/data_monitoring.rst:28
msgid "잡 로그"
msgstr ""

# c5d7be3d2b464551ac5287ad3b2eadb4
#: ../../discovery/part02/data_monitoring.rst:30
msgid ""
"본 메뉴에서는 Metatron에서 수행된 모든 쿼리의 내역을 조회할 수 있습니다. 쿼리 이력을 원하는 조건으로 검색하여 기존에 "
"발생한 job 이력을 손쉽게 찾아볼 수 있습니다. 아래는 검색이 가능한 job 조건들입니다."
msgstr ""

# 16cdc50ec63140389551d5bb8149cc74
#: ../../discovery/part02/data_monitoring.rst:34
msgid "**상태:** 수행된 쿼리들을 성패 기준으로 선별하여 조회합니다."
msgstr ""

# dd76b2f738d749819163f787f9c6f9cb
#: ../../discovery/part02/data_monitoring.rst:35
msgid ""
"**Limited elapsed time:** 수행 시간이 오래 소요된 쿼리들을 선별하여 조회합니다. 기준 시간은 원하는 대로 설정"
" 가능합니다."
msgstr ""

# b6f0d94104f34000a94f1180937a932b
#: ../../discovery/part02/data_monitoring.rst:36
msgid ""
"**Performed start Time:** 쿼리 조회 시 적용되는 시간 기준입니다. 여기서의 시간은 각 쿼리가 수행을 시작하는 "
"시간을 기준으로 합니다."
msgstr ""

# 1d74645191884139bcfeffcf61acffaa
#: ../../discovery/part02/data_monitoring.rst:37
msgid "**Job 또는 어플리케이션으로 검색:** 현재 이력으로 남은 쿼리들을 쿼리문 또는 Application ID로 검색합니다."
msgstr ""

# fab563eaddee4fd89392bb10d6fe7e4f
#: ../../discovery/part02/data_monitoring.rst:38
msgid "**데이터 개수:** 현재 목록에 조회된 쿼리의 개수를 나타냅니다."
msgstr ""

# 6846458d593a4109a6eeab1d51a60c01
#: ../../discovery/part02/data_monitoring.rst:39
msgid "**Job 목록:** 설정한 선별 조건에 맞는 쿼리들을 보여줍니다. 이 중 하나를 클릭하면 상세 내역을 볼 수 있습니다."
msgstr ""

# b91679ae25874a838010117e9a0eb83b
#: ../../discovery/part02/data_monitoring.rst:42
msgid "쿼리 상세 정보"
msgstr ""

# 4b83b4d75c924cdfb3badcc2b4c5bf69
#: ../../discovery/part02/data_monitoring.rst:44
msgid ""
"잡 로그 홈에 열거된 쿼리 중 하나를 클릭하면 해당 쿼리에 관한 다양한 정보와 이력을 확인할 수 있습니다. 상세 내역에서 조회 "
"가능한 정보는 다음과 같습니다."
msgstr ""

# 5bbe0860ff014ddda289218f6ae315d5
#: ../../discovery/part02/data_monitoring.rst:50
msgid "**상태:** 해당 쿼리의 성공 여부를 나타냅니다."
msgstr ""

# f809a0c797904f1c9f2060faf595582b
#: ../../discovery/part02/data_monitoring.rst:51
msgid "**잡 이름:** 수행된 쿼리문입니다."
msgstr ""

# d5f65b7aff294c4e998894161e9e794b
#: ../../discovery/part02/data_monitoring.rst:52
msgid "**시작시간:** 해당 쿼리가 수행되기 시작한 시간을 나타냅니다."
msgstr ""

# 81b93e92c5ed4bebb79218c99e5b3742
#: ../../discovery/part02/data_monitoring.rst:53
msgid "**작업시간:** 해당 쿼리가 수행되는 데 걸린 시간을 나타냅니다."
msgstr ""

# c5b0ac6e392d4140b05c585dee6f8bae
#: ../../discovery/part02/data_monitoring.rst:54
msgid "**사용자:** 해당 쿼리를 수행한 사용자 ID입니다."
msgstr ""

# e59a925f433540499e36d544a689ae86
#: ../../discovery/part02/data_monitoring.rst:55
msgid "**커넥션:** 워크벤치에서 실행된 쿼리일 경우, 대상 데이터 커넥션의 정보를 나타냅니다."
msgstr ""

# 5548601fb7c145f897a7df5e9143978b
#: ../../discovery/part02/data_monitoring.rst:56
msgid ""
"**동일 커넥션의 최근 사용 기록:** 워크벤치에서 실행된 쿼리일 경우, 해당 데이터베이스에서 수행된 최근 5건의 쿼리 내역과 그 "
"결과가 나타납니다. Detail을 클릭하면 해당 쿼리문이 새 창에 출력됩니다."
msgstr ""

# 13a181ba55594c73aa1a0c4efba3a1be
#: ../../discovery/part02/data_monitoring.rst:57
msgid "**플랜:** 쿼리 수행 계획을 실행합니다."
msgstr ""
