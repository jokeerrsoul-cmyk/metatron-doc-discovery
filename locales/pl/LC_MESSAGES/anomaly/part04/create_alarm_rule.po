msgstr ""

# 396b8f421c054128a81e542148ed423f
#: ../../anomaly/part04/create_alarm_rule.rst:165
#: f6bb9db3bf114e4da5b54359aba6419d
msgid "**Threshold:** Abnormal Score가 이 설정값을 초과하면 데이터 이상 상태로 간주됩니다."
msgstr ""

