# 0dbb8cd1761d453580c16d3ce62dcb92
#: ../../anomaly/part06/index.rst:2 30f23b4b948347f2aba56e56f81fe0fb
msgid "대시보드"
msgstr ""

# f305fe3e848c4470bbbc84d0b81fff76
#: ../../anomaly/part06/index.rst:9 9edb0bd77a564d128b90a3521d7924d6
msgid ""
"Metatron Anomaly는 머신러닝 모델을 활용한 이상 탐지 기능과 별도로 데이터 소스 자체에 대한 모니터링 기능을 "
"제공합니다. 알람이 발생한 후에 원인을 찾기 위해서 활용하거나, 어떤 측정값(measure)에 어떤 차원값(dimension)을 "
"대상으로 알람 룰을 생성할지 확인하기 위해서도 활용할 수 있습니다."
msgstr ""

# 9a5927a8596047e7a7a3f4bcb2e1b914
#: ../../anomaly/part06/index.rst:11 d6ab0f3920f945b994af381afa3b1380
msgid ""
"그 중 대시보드는 Data Monitoring의 하위 메뉴로, 정해진 차트 몇 가지로 빠르게 데이터 소스에 대한 현황을 파악할 수 "
"있도록 만들어진 기능입니다."
msgstr ""

#: ../../anomaly/part06/index.rst:13 6f4f594d7efc498a93375b90128726d3
msgid "Metatron Anomaly LNB"
msgstr ""

# 1c61db190db04612b99068cb5e970a38
#: ../../anomaly/part06/index.rst:19 74107b9a88ec4f8ea55c4a22586e1b57
msgid "데이터 소스 선정"
msgstr ""

# bd097a14e2d8417cbc19b8b5b7e7b00b
#: ../../anomaly/part06/index.rst:21 e8fc7fd2a5fd429c9c9fd021ec5f392d
msgid ""
"가장 먼저 모니터링할 데이터 소스를 선택해야 합니다. 대시보드에 처음으로 진입하면 데이터소스를 선택하는 버튼이 다음과 같이 "
"나타납니다."
msgstr ""

#: ../../anomaly/part06/index.rst:23 63f9056d44de4ab68df4a551c90cb4b3
msgid "Datasource dashbaord"
msgstr ""

# e15b8f83968e409f899368a2ae56723c
#: ../../anomaly/part06/index.rst:27 4c670fb8f9984389b0d90889c41d130a
msgid "버튼을 클릭 후 모니터링할 데이터 소스를 선택합니다."
msgstr ""

#: ../../anomaly/part06/index.rst:29 8b271993fe9c45dba8ca97119b01a55f
msgid "Select Datasource"
msgstr ""

# e83f6ae5c12b4cb082de07eb099d4064
#: ../../anomaly/part06/index.rst:34 12f2aebead404ec7877ba05131afaa61
msgid "실시간 대시보드"
msgstr ""

# 68d4c832765548838d85ea251e4181a4
#: ../../anomaly/part06/index.rst:36 cf4163266f6b41b1815f64432f6fa157
msgid ""
"데이터 소스를 선택하면 즉시 주요 측정 값 4개에 대한 차트들로 이루어진 대시보드가 만들어집니다. 이 대시보드는 사용자가 다른 "
"메뉴로 이동 후에 다시 돌아와도 그대로 유지됩니다."
msgstr ""

#: ../../anomaly/part06/index.rst:38 ../../anomaly/part06/index.rst:52
#: ../../anomaly/part06/index.rst:58 ../../anomaly/part06/index.rst:64
#: 4ac0dbb5c7064816b21a9267b2b9c536 51d09372b853432db0ebd4cfeac4b218
#: ad33640e056f47338fb9900b0ebec5e2 fd4520e49f174fa2b41c936c7b38503c
msgid "Dashboard"
msgstr ""

# 2d0fe0b2c6654d72a9a3cdcd5ecb45f6
#: ../../anomaly/part06/index.rst:43 cdcf874027424e568f9563af5fa10e0f
msgid ""
"대시보드의 상단에는 데이터소스의 정보를 보여줍니다. 모니터링 하고자 하는 데이터 소스를 변경하려면 데이터 소스 이름 우측의 "
"|icon_edit| 을 누릅니다."
msgstr ""

#: ../../anomaly/part06/index.rst:4 570a7cb156d248a0a0ff3c107962e6e3
msgid "icon_edit"
msgstr ""

# e9834f5a68db4fea89925f1f889c1905
#: ../../anomaly/part06/index.rst:50 43ffd775bf264cbca6b50c5d1510d621
msgid ""
"만약 데이터 소스 선택 후 어떤 차트도 그려지지 않는다면 우측 drop-down 메뉴에서 모니터링 대상 기간을 확인하세요. 이 "
"대시보드는 지속적으로 업데이트 되는 데이터 소스를 모니터링 하는 것을 권장합니다. 정적인 데이터 소스에 대한 대시보드는 "
"Metatron Discovery를 활용해보세요."
msgstr ""

# ab9d182ff1c943648d37e55611211a69
#: ../../anomaly/part06/index.rst:56 d4937d11e541400da4c532f7b08e6625
msgid ""
"상단의 |icon_update| 를 누르면 대시보드를 정해진 시간마다 갱신합니다. 기본적으로는 10초마다 업데이트하며 갱신 주기는 "
"3초, 20초 또는 30초로 변경할 수 있습니다."
msgstr ""

#: ../../anomaly/part06/index.rst:5 d3a23af2d3ca485a9bcd4f6b704d0709
msgid "icon_update"
msgstr ""

# d40b89d3ac9742fda4f3a46bd2054a95
#: ../../anomaly/part06/index.rst:62 118bb86443fd4dad8839196a60759e1c
msgid ""
"|icon_full| 을 누르면 전체화면 모드로 전환됩니다. 전체화면 모드에서 다시 |icon_full| 을 누르면 본 화면으로 "
"돌아옵니다."
msgstr ""

#: ../../anomaly/part06/index.rst:6 434b76372931430da4a973173578b080
#: 827ebb14262c44249616c2d2dcbbd70c
msgid "icon_full"
msgstr ""

# e63464523bd84fad9f9d79620ec23a9e
#: ../../anomaly/part06/index.rst:69 c483382897874db88bb4a5a68b28e74d
msgid "차트"
msgstr ""

# 803078874b664bbcae49af7e9aa9d945
#: ../../anomaly/part06/index.rst:71 655b47bccc3a44008153d1f8eea95b41
msgid "대시보드에는 선정된 데이터 소스에서 임의의 측정값(measure) 4개에 대한 11개의 차트가 자동으로 그려집니다."
msgstr ""

# 936486869f7b4959bf70b831d16377b6
#: ../../anomaly/part06/index.rst:73 8e766e7647c54b50a095f36d4f6c1f6e
msgid "**측정값(measure) KPI 차트** : 개별 측정값 4개에 대해 현재값 및 평균 값에 대한 KPI 차트입니다."
msgstr ""

#: ../../anomaly/part06/index.rst:75 ../../anomaly/part06/index.rst:81
#: ../../anomaly/part06/index.rst:87 ../../anomaly/part06/index.rst:94
#: ../../anomaly/part06/index.rst:101 ../../anomaly/part06/index.rst:118
