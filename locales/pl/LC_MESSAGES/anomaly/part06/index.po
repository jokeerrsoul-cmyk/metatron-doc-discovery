#: 650763dc3edf454d86f17e4d084bb91a 9f260d7b5e084cb79c66114ac3f76780
#: a506585373954696bbc9a69bbaec555f ee3136f4e16b4ae69a9de2f79b6cca4b
#: f26dbae11d204e81ac4ebc615c0ae025 fa33d678e7014b9f858dc1fee59ad0d8
msgid "Chart"
msgstr ""

# 52ff08ca890b4893a90bc8f3111c2dc8
#: ../../anomaly/part06/index.rst:79 3995b60011ad46c59809dbef0d863cf7
msgid ""
"**차원값(dimension) 별 측정값 라인 차트** : 임의로 선택된 차원값 1개에 대해 개별 측정값 4개에 대한 라인 차트를 "
"그립니다."
msgstr ""

# 51cf647e18904ef98e836bf24bf53b9a
#: ../../anomaly/part06/index.rst:85 55dae6bb0f31437f94eda3c218d80f0f
msgid "**데이터 수집 현황** : 24시간 동안 몇 개의 데이터 레코드가 수집되었는지 기록한 막대 차트입니다."
msgstr ""

# 7d7a636c163641af8e0a211a8da77494
#: ../../anomaly/part06/index.rst:92 ed27a24342c344fd97ea624276342b5d
msgid "**데이터 수집 지연 시간** : 가장 최근 데이터가 수집된 시간과 현재 시간과의 차이로 수집 지연 시간을 나타낸 차트입니다."
msgstr ""

# 9a6e217e240246a8b9e1ee2486c45eba
#: ../../anomaly/part06/index.rst:99 4754acd3108d4d71b48493846572f44c
msgid "**알람 발생 분포** : 해당 데이터 소스로 발생한 알람들을 심각도 별로 나누어 개수를 나타내는 파이 차트입니다."
msgstr ""

# 7d17dba04a204070aa252141102ca2f0
#: ../../anomaly/part06/index.rst:107 f24397da3c0747288bf5147eda724110
msgid "차트 변경"
msgstr ""

# 5ca5c32433b346ac8c086b800e5525e6
#: ../../anomaly/part06/index.rst:109 fa0952c0d9b54eb88c03a25a8d895de7
msgid "각 차트들은 우측의 |icon_more| 버튼을 누르면 정보를 변경할 수 있습니다."
msgstr ""

#: ../../anomaly/part06/index.rst:7 490c3c9863aa445fbcfa165e490bbd12
msgid "icon_more"
msgstr ""

#: ../../anomaly/part06/index.rst:111 8ede508bd2644610ad198a88f3d30505
msgid "Metatron Anomaly Chart"
msgstr ""

# 123a1b52019244c8983da30d7085824a
#: ../../anomaly/part06/index.rst:116 4025cbd1ce684a0b9b1291fb901abc6a
msgid "**차트 정보 수정** : 차트의 이름을 변경하거나 설명을 추가할 수 있습니다."
msgstr ""

# 76347e30a54343239f8ae9118341383d
#: ../../anomaly/part06/index.rst:123 cbefc24d496f4c39a8f9bd75b489dfcf
msgid "**차트 데이터 변경** : 차트에 그려지는 측정값 또는 차원값을 변경할 수 있습니다."
msgstr ""

# 5aedd1d40bea4bff9ffb8adeb3d0d773
#: ../../anomaly/part06/index.rst:130 e462fb5b8f92412b9e198aefd473482d
msgid "**차트 새로고침** : 해당 차트에 대해 최신 데이터로 업데이트 합니다."
msgstr ""

# 33ac58337cd042ce8847e6c786fd2996
#: ../../anomaly/part06/index.rst:132 a673caa796e246e8b69932dfb6a594f6
msgid "**차트 초기화** : 최초 설정된 측정값 및 차원값으로 그려진 차트로 초기화합니다."
msgstr ""

