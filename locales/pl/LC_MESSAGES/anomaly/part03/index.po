# 3ab5ecb6bf604c39bb75dcf6ed3c2b45
#: ../../anomaly/part03/index.rst:42 2c91cc9c07564eed876509f3d323612b
msgid ""
"이 영역에서는 해당 알람의 발생 현황을 보여줍니다. 정해진 주기에 따라 알람이 연속적으로 발생하면 1개의 알람 항목으로 계속 "
"유지되며, 알람의 심각도(severity) 기준을 넘은 데이터 포인트 수가 함께 표기됩니다. 또한 알람을 확인한 후 처리 결과를 "
"기록할 수 있도록 링크를 제공합니다. 내가 생성한 알람 룰이 아닌 경우 **Subscribe**\\을 눌러 해당 알람 룰로 추후 "
"발생한 알람들에 대해 알림을 받을 수 있습니다."
msgstr ""

# f364a2fc74e94b0db3864cf9004f718b
#: ../../anomaly/part03/index.rst:44 6f90739431b84788a3113d81a841a2e0
msgid ""
"아래 그림 예시에서는 알람이 2번 연속적으로 발생하였고(**Alarms**), 알람 확인 주기가 1분이기 때문에 2건의 알람이 총 "
"120초 동안 지속된 것을 보여주고 있습니다.(**Elapsed Time**)."
msgstr ""

#: ../../anomaly/part03/index.rst:46 55aac08127b94d85ab73c55bb91f2153
msgid "alarm overview"
msgstr ""

